<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The Flutter template declares INTERNET only in the debug and profile
         manifests, where it exists so the tooling can attach. A release build
         merges neither, so without this the installed app launches and then
         fails every API call. Cleartext stays off here: release traffic goes to
         HTTPS, and the debug manifest keeps its own exemption for the local
         dev server. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="PhamDash"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- The Flutter template ships android:taskAffinity="" on this activity
             as a task-hijacking mitigation. It must stay off: AppAuth's
             AuthorizationManagementActivity is singleTask and declares no
             affinity, so it and RedirectUriReceiverActivity sit in the default
             "com.phamdash.app" task while an empty-affinity MainActivity sits
             in another. The browser redirect then lands in the wrong task, on a
             fresh AuthorizationManagementActivity that never stored the
             request, and sign-in dies with
             "W/AppAuth: No stored state - unable to handle response".
             Do not restore it when syncing the template. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
